default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # Register bundle ID if it doesn't exist yet (replaces `produce`)
    # This is handled in the workflow via ASC API call before fastlane runs

    # Fetch or create provisioning profile for manual signing
    sigh(
      api_key: api_key,
      app_identifier: "com.codynamics.ironhell",
      provisioning_name: "IRONHELL AppStore",
      force: true,
      adhoc: false
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profile_uuid = lane_context[SharedValues::SIGH_UDID]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: ENV["TEAM_ID"],
      bundle_identifier: "com.codynamics.ironhell",
      code_sign_identity: "iPhone Distribution",
      profile_uuid: profile_uuid
    )

    gym(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.codynamics.ironhell" => profile_uuid
        }
      },
      clean: true,
      output_directory: "./build",
      output_name: "IRONHELL.ipa",
      build_number: ENV["BUILD_NUMBER"]
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/IRONHELL.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
